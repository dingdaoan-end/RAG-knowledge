# Copy only if .env does not exist. Preserve existing DeepSeek provider values.
# API_KEY and OPENAI_API_KEY are aliases; fill only the one already in use.
API_KEY=replace_with_existing_api_key
OPENAI_API_KEY=
MODEL_NAME=replace_with_existing_model_name
BASE_URL=https://replace-with-existing-provider-base-url

# Host paths. Use forward slashes on Windows; select the hub folder, not its parent.
HF_CACHE_DIR=C:/Users/YOUR_NAME/.cache/huggingface/hub
UPLOAD_DATA_DIR=./data/uploads
KNOWLEDGE_DIR=./data
MAX_UPLOAD_BYTES=10485760

# Public snapshot revisions found in this project's existing cache.
# If your prepared cache uses other revisions, use those directory names.
EMBEDDING_REVISION=7999e1d3359715c523056ef9478215996d62a620
RERANKER_REVISION=2cfc18c9415c912f9d8155881c133215df768a70
